# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/scamshield

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# AI Provider Configuration (Choose ONE)
# ============================================

# Which AI provider to use: openai, groq, huggingface, ollama, gemini
AI_PROVIDER=groq

# ------------------------------
# Option 1: Groq (RECOMMENDED - FREE & FAST!)
# ------------------------------
# Get free API key at: https://console.groq.com
# Models: mixtral-8x7b-32768, llama3-70b-8192, gemma-7b-it
# Rate limit: 30 requests/minute (free tier)
GROQ_API_KEY=your-groq-api-key-here

# ------------------------------
# Option 2: Google Gemini (FREE!)
# ------------------------------
# Get free API key at: https://makersuite.google.com/app/apikey
# Models: gemini-pro (free tier available)
# Rate limit: 60 requests/minute (free tier)
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------
# Option 3: Hugging Face (FREE!)
# ------------------------------
# Get free API key at: https://huggingface.co/settings/tokens
# Models: facebook/bart-large-mnli, sentence-transformers
# Rate limit: Generous free tier
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# ------------------------------
# Option 4: Ollama (FREE & LOCAL - No API key!)
# ------------------------------
# Install: https://ollama.ai/download
# Run: ollama run llama3
# No API key needed - runs on your computer!
OLLAMA_URL=http://localhost:11434

# ------------------------------
# Option 5: OpenAI (PAID but Best Quality)
# ------------------------------
# Get API key at: https://platform.openai.com/api-keys
# Note: Requires credit card and charges per use
# Models: gpt-3.5-turbo, gpt-4
OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# Optional Services
# ============================================

# Google Cloud Services (Optional - for voice features)
# Download service account key JSON and set path
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
# OR use API key
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key

# Google Safe Browsing API (Optional - for enhanced URL scanning)
# Get free key at: https://developers.google.com/safe-browsing
SAFE_BROWSING_API_KEY=your-safe-browsing-api-key

# Rate Limiting (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
